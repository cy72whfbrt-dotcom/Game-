# Open Water – welche Zugangsdaten hochladen.sh braucht (NUR als Vorlage, KEINE echten Werte hier eintragen!)
# Die echten Werte stehen ausschließlich in den Umgebungsvariablen der Cloud-Umgebung „Unity“.
# hochladen.sh schreibt daraus Game/config.php (nur auf dem Server, nie im Git, im Browser leer).
OFFICE_USER=
OFFICE_PASS=
DB_USER=
DB_PASS=
# optional:
DB_HOST=dbwebintern.silentnetwork.de
DB_NAME=k17700_alex
ADMIN_IDS=3
# Push-Benachrichtigungen (optional – sonst erzeugt der Server die Schlüssel selbst, siehe doku/server-weltrechner-hauptbuch.md):
VAPID_PUBLIC=
VAPID_PRIVATE=
# Der Schlüssel des Weltrechners wird NICHT hier gesetzt: hochladen.sh erzeugt bei jedem Hochladen einen neuen zufälligen.
